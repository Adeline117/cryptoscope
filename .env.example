# CryptoScope Environment Variables
# Copy to .env and fill in your values

# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TG_REVIEW_CHANNEL=

# Recommended
GITHUB_TOKEN=
ETHERSCAN_API_KEY=
# Optional pool of Etherscan keys (comma-separated) for rate-limit rotation
ETHERSCAN_API_KEYS=

# On-chain data (accumulation detection system)
ALCHEMY_API_KEY=
HELIUS_API_KEY=
# Solana RPC — set to Helius endpoint for higher rate limits:
#   https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
SOLANA_RPC_URL=
# NOTE: Solscan free keys cannot access holders/meta (HTTP 401 "upgrade");
# Solana holder distribution is sourced from Helius instead.
SOLSCAN_API_KEY=

# Optional (paid APIs)
DUNE_API_KEY=
COINGECKO_API_KEY=
MESSARI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
TWITTER_BEARER_TOKEN=

# Arena database (for arena_db collector)
ARENA_DB_HOST=
ARENA_DB_USER=
ARENA_DB_PASS=

# Blockchain explorers (optional)
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_API_KEY=

# Economic data (optional)
FRED_API_KEY=
