# CryptoScope Environment Variables
# Copy to .env and fill in your values

# Long-running scheduler resource guardrails
SCHEDULER_MAX_WORKERS=8
SCHEDULER_NOFILE_SOFT=2048

# Exchange mutation gate. research is the fail-closed default; paper also blocks
# real orders. Live additionally requires an out-of-band token supplied to each
# state-changing call. Never commit the approval token.
CRYPTOSCOPE_EXECUTION_MODE=research
# CRYPTOSCOPE_LIVE_APPROVAL_TOKEN=

# Required
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TG_REVIEW_CHANNEL=

# Recommended
GITHUB_TOKEN=
ETHERSCAN_API_KEY=
# Optional pool of Etherscan keys (comma-separated) for rate-limit rotation
ETHERSCAN_API_KEYS=

# On-chain data (accumulation detection system)
ALCHEMY_API_KEY=
HELIUS_API_KEY=
# Solana RPC — set to Helius endpoint for higher rate limits:
#   https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
SOLANA_RPC_URL=
# Standard endpoints used by the read-only launch stream. The public defaults
# work without paid Helius transactionSubscribe access; use dedicated provider
# endpoints in production when sustained rate limits are required.
SOLANA_STREAM_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_STREAM_WS_URL=wss://api.mainnet-beta.solana.com/

# Read-only EVM factory stream endpoint pools (comma-separated fallbacks).
BSC_FACTORY_RPC_URLS=https://bsc.rpc.blxrbdn.com,https://bsc.drpc.org
BSC_FACTORY_WS_URLS=wss://bsc-rpc.publicnode.com,wss://bsc.drpc.org
BASE_FACTORY_RPC_URLS=https://mainnet.base.org,https://base.drpc.org
BASE_FACTORY_WS_URLS=wss://base-rpc.publicnode.com,wss://base.drpc.org
ETH_FACTORY_RPC_URLS=https://rpc.flashbots.net,https://eth.drpc.org,https://ethereum-rpc.publicnode.com
ETH_FACTORY_WS_URLS=wss://ethereum-rpc.publicnode.com,wss://eth.drpc.org

# Optional read-only router quotes for Launch execution validation. Without these,
# raw actionable candidates fail closed to WATCH (no transactions are submitted).
JUPITER_API_KEY=
ZEROX_API_KEY=
# NOTE: Solscan free keys cannot access holders/meta (HTTP 401 "upgrade");
# Solana holder distribution is sourced from Helius instead.
SOLSCAN_API_KEY=

# Optional (paid APIs)
ARKHAM_API_KEY=
DUNE_API_KEY=
COINGECKO_API_KEY=
MESSARI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
TWITTER_BEARER_TOKEN=

# Arena database (for arena_db collector)
ARENA_DB_HOST=
ARENA_DB_USER=
ARENA_DB_PASS=

# Blockchain explorers (optional)
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_API_KEY=

# Economic data (optional)
FRED_API_KEY=

# Optional archive RPCs for full multi-chain reconstruction (e.g. paid QuickNode/Alchemy)
# RPC_BSC=
# RPC_BASE=
# RPC_ARBITRUM=
