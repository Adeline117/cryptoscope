{#
Macro Economic Event Thread Template
Used for: FOMC decisions, CPI releases, NFP, Core PCE, etc.
#}

{# === ENGLISH VERSION === #}

{% block en_thread %}
{# Tweet 1: Hook with the data #}
{{ hook_en }}
{# e.g.: ⚡ CPI just came in HOT — 3.2% vs 3.0% expected. Here's what it means for crypto. #}

{# Tweet 2: The Data #}
2/{{ total_tweets }} 📊 {{ event_name }}:
Actual: {{ actual_value }} {{ "✅ beat" if actual_vs_expected == "beat" else "❌ miss" if actual_vs_expected == "miss" else "➡️ inline" }}
Expected: {{ expected_value }}
Previous: {{ previous_value }}
[ATTACH: {{ surprise_chart }}]

{# Tweet 3: Immediate Market Reaction #}
3/{{ total_tweets }} ⚡ Market reaction (first 15 min):
BTC: {{ btc_reaction }}
DXY: {{ dxy_reaction }}
10Y: {{ yield_10y_reaction }}
S&P 500: {{ spx_reaction }}

{# Tweet 4: Fed Implications #}
4/{{ total_tweets }} 🏛️ {{ fed_implications_en }}
{# What this means for rate cut/hike expectations #}
{# CME FedWatch probabilities #}

{# Tweet 5: Historical Context #}
5/{{ total_tweets }} {{ historical_context_en }}
[ATTACH: {{ context_chart }}]

{# Tweet 6: Crypto-Specific Impact #}
6/{{ total_tweets }} 🔍 {{ crypto_impact_en }}
{# ETF flows, funding rates, OI changes #}

{# Tweet 7: Arena Connection (if relevant) #}
{% if arena_angle_en %}
7/{{ total_tweets }} {{ arena_angle_en }}
{# Top traders' positioning after the data release #}
{% endif %}

{# Tweet 8: Takeaway #}
{{ total_tweets }}/{{ total_tweets }} 🔑 {{ takeaway_en }}
Full analysis: {{ openclaw_url }}
{% endblock %}

